# ================================================
# NCP Commerce Web - Environment Variables Template
# Copy this file to .env and adjust credentials for Production/Cloud
# ================================================

# MySQL Database
MYSQL_DATABASE=ncp_com_db
MYSQL_ROOT_PASSWORD=YourStrongDatabasePassword123!
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=YourStrongDatabasePassword123!

# JWT Token Security (Generate a strong 256-bit+ random secret)
APP_JWT_SECRET=4f7a93c8d1b2e5a6f84920c1d4e7f9a8b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6
APP_JWT_EXPIRATION_MS=86400000

# Root Administrator (Provincial Director)
# Used to bootstrap the system in cloud/clean database deployments
APP_DIRECTOR_USERNAME=provincial_director
APP_DIRECTOR_PASSWORD=NcpDirector@2026#Secure

# Frontend URL / API Base (Leave blank if served behind Nginx reverse proxy)
VITE_API_URL=
